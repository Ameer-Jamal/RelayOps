RELAYOPS_APP_NAME=RelayOps
RELAYOPS_LOG_LEVEL=info

RELAYOPS_DATA_DIR=.relayops
RELAYOPS_DB_PATH=.relayops/state/relayops.db
RELAYOPS_RULES_FILE=rules.local.yaml

RELAYOPS_SERVER_ENABLED=true
RELAYOPS_SERVER_HOST=127.0.0.1
RELAYOPS_SERVER_PORT=4317

RELAYOPS_SCHEDULER_ENABLED=false
RELAYOPS_NEW_PR_INTERVAL_MS=60000
RELAYOPS_UNREAD_MESSAGE_INTERVAL_MS=120000

RELAYOPS_BROWSER_HEADLESS=false
RELAYOPS_BROWSER_PROFILE_DIR=.relayops/browser-profile
RELAYOPS_BROWSER_CAPTURE_SCREENSHOTS=true
RELAYOPS_BROWSER_SCREENSHOTS_DIR=.relayops/screenshots
RELAYOPS_BROWSER_CHANNEL=

RELAYOPS_TEAMS_BASE_URL=https://teams.microsoft.com/
RELAYOPS_TEAMS_LOGIN_TIMEOUT_MS=120000
RELAYOPS_TEAMS_NAVIGATION_TIMEOUT_MS=45000
RELAYOPS_TEAMS_SELECTOR_TIMEOUT_MS=4000
RELAYOPS_TEAMS_ACTION_RETRIES=3
RELAYOPS_TEAMS_VALIDATE_SESSION_ON_STARTUP=false
RELAYOPS_TEAMS_WAIT_FOR_LOGIN_ON_STARTUP=false
RELAYOPS_TEAMS_LOGIN_POLL_INTERVAL_MS=2000

RELAYOPS_PR_SOURCE_PATH=examples/pr-feed.example.json
RELAYOPS_PR_SOURCE_URL=
RELAYOPS_PR_SOURCE_LIMIT=25

RELAYOPS_ALERTS_ENABLED=true
RELAYOPS_ALERTS_SOUND_ENABLED=true
